# AI Friends — Docker Compose 部署环境变量
# 用法（项目根目录）：cp .env.example .env，填入真实值后 docker compose up -d
# 注意：这是 Docker 部署专用的根 .env，与本地开发的 backend/.env 不同——
#       容器间用 compose 服务名（postgres/redis），不是 127.0.0.1

# DashScope API
API_KEY=
API_BASE=
WSS_URL=
VOICE_URL=

# PostgreSQL — host 用 compose 服务名
# PG_PASSWORD 同时用于 POSTGRES_PASSWORD，必填（留空 compose 会 fail-fast 拒绝启动）。
# ⚠️ 复用现有 PG 卷时须 = 现有 aifriends 用户的旧密码，否则 Django 连不上。
PG_HOST=postgres
PG_PORT=5432
PG_NAME=aifriends
PG_USER=aifriends
PG_PASSWORD=

# OSS（暂未使用）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=

# Django — 生产模式（DEBUG=False 时 DJANGO_SECRET_KEY 必填）
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-server-ip

# Celery / Redis — host 用 compose 服务名
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_URL=redis://redis:6379/1

# CORS / Media
DJANGO_CORS_ORIGINS=https://your-server-ip
DJANGO_MEDIA_URL=https://your-server-ip/media/
